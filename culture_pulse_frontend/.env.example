# === Supabase Credentials (REQUIRED for all backend/frontend integration) ===
REACT_APP_SUPABASE_URL=your-supabase-project-url
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-public-api-key

# === Application Site URL (REQUIRED for correct Supabase auth redirects) ===
REACT_APP_SITE_URL=http://localhost:3000

# IMPORTANT:
# - Obtain values from your Supabase Project > Settings > API.
# - In production, set REACT_APP_SITE_URL to your deployed domain (e.g., https://yourapp.com).
# - Do NOT check in the real .env file or any secrets to version control.
